{
  "name": "xiaohongshu-publisher-desktop",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:developer": "vite --mode developer --host 127.0.0.1",
